{
  "name": "mthread-js",
  "version": "1.0.1",
  "description": "True multithreading for Node.js — auto and manual thread control, built on native worker_threads.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.js test/process-exit.test.js",
    "coverage": "c8 --check-coverage --statements 85 --branches 80 --functions 85 --lines 85 --reporter=text --reporter=lcov node --test test/index.test.js test/process-exit.test.js",
    "lint": "eslint .",
    "example": "node examples/demo.js"
  },
  "keywords": [
    "multithreading",
    "worker_threads",
    "threads",
    "parallel",
    "nodejs",
    "performance",
    "concurrency",
    "background"
  ],
  "author": "AtaberkCelil",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtaberkCelil/mthread-js.git"
  },
  "homepage": "https://github.com/AtaberkCelil/mthread-js#readme",
  "bugs": {
    "url": "https://github.com/AtaberkCelil/mthread-js/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  }
}
