{
  "name": "ts-worker-pool",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance, type-safe worker pool for Node.js and browsers — CPU-bound tasks, transferable buffers, timeouts, crash recovery.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark": "npm run build && node dist/examples/benchmark.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
